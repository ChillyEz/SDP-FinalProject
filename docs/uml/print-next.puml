@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam defaultFontColor #172B36
skinparam sequenceArrowColor #355D66
skinparam sequenceLifeLineBorderColor #96A9AD
skinparam sequenceParticipantBorderColor #648089
skinparam sequenceGroupBorderColor #A8B9BD
skinparam sequenceGroupBackgroundColor #F0F5F4
skinparam sequenceGroupHeaderFontColor #25464A
skinparam ParticipantPadding 12
hide footbox
actor Operator
participant "PrintCenter" as Center #E1F2EE
participant "QueuePolicy" as Policy #ECF0FC
participant "ConsolePrinter" as Printer #E1F2EE
participant "PrintSubscriber" as Subscriber #F8EFE5

Operator -> Center : printNext()
Center -> Policy : selectNext(pendingOrders)
Policy --> Center : selected order or empty
alt empty queue
    Center --> Operator : Optional.empty()
else order selected
    Center -> Printer : print(order)
    alt paper jam
        Printer --> Center : IllegalStateException
        Center --> Operator : propagate error; order stays pending
    else print succeeds
        Printer --> Center : return
        Center -> Center : remove order from queue
        loop once per subscriber in the delivery snapshot
            Center -> Subscriber : onPrinted(order)
        end
        Center --> Operator : Optional.of(order)
    end
end
@enduml
