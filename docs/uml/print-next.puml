@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam defaultFontColor #161616
skinparam sequenceArrowColor #555555
skinparam sequenceLifeLineBorderColor #555555
skinparam sequenceParticipantBorderColor #555555
skinparam sequenceGroupBorderColor #555555
skinparam sequenceGroupBackgroundColor #EEEEEE
skinparam sequenceGroupHeaderFontColor #161616
skinparam ParticipantPadding 12
hide footbox
actor Operator
participant "PrintCenter" as Center #F5F5F5
participant "QueuePolicy" as Policy #F5F5F5
participant "ConsolePrinter" as Printer #F5F5F5
participant "PrintSubscriber" as Subscriber #F5F5F5

Operator -> Center : printNext()
Center -> Policy : selectNext(pendingOrders)
Policy --> Center : selected order or empty
alt empty queue
    Center --> Operator : Optional.empty()
else order selected
    Center -> Printer : print(order)
    alt paper jam
        Printer --> Center : IllegalStateException
        Center --> Operator : return error (order stays pending)
    else print succeeds
        Printer --> Center : return
        Center -> Center : remove order from queue
        loop once per subscriber in the delivery snapshot
            Center -> Subscriber : onPrinted(order)
        end
        Center --> Operator : Optional.of(order)
    end
end
@enduml
