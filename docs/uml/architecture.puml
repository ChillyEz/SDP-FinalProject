@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam defaultFontColor #161616
skinparam rectangleBorderColor #555555
skinparam arrowColor #555555
skinparam nodesep 24
skinparam ranksep 22
skinparam roundCorner 0
rectangle B #F5F5F5 [
<b>Builder</b>
{{
!include_many class-style.iuml
class "PrintJob.Builder" as Builder
class PrintJob
Builder .right.> PrintJob : builds
}}
]
rectangle D #F5F5F5 [
<b>Decorator</b>
{{
!include_many class-style.iuml
interface PrintService <<interface>>
abstract class PrintServiceDecorator
class BasicPrinting
class Cover
class Binding
class LineItem <<record>>
PrintService <|.. BasicPrinting
PrintService <|.. PrintServiceDecorator
PrintServiceDecorator o-left- PrintService : wraps
PrintServiceDecorator <|-- Cover
PrintServiceDecorator <|-- Binding
PrintService .right.> LineItem
}}
]
rectangle F #F5F5F5 [
<b>Facade</b>
{{
!include_many class-style.iuml
class PrintCenter
class ConsolePrinter
PrintCenter -right-> ConsolePrinter
}}
]
rectangle S #F5F5F5 [
<b>Strategy</b>
{{
!include_many class-style.iuml
interface QueuePolicy <<interface>>
class FirstComeFirstServed
class ShortestJobFirst
QueuePolicy <|.. FirstComeFirstServed
QueuePolicy <|.. ShortestJobFirst
}}
]
rectangle O #F5F5F5 [
<b>Observer</b>
{{
!include_many class-style.iuml
interface PrintSubscriber <<interface>>
class PrintJournal
class PrintStatistics
PrintSubscriber <|.. PrintJournal
PrintSubscriber <|.. PrintStatistics
}}
]
rectangle G #F5F5F5 [
<b>Bridge</b>
{{
!include_many class-style.iuml
abstract class OrderDocument
class Receipt
class JobTicket
interface DocumentRenderer <<interface>>
class PlainTextRenderer
class MarkdownRenderer
class DocumentField <<record>>
OrderDocument <|-- Receipt
OrderDocument <|-- JobTicket
OrderDocument -right-> DocumentRenderer
DocumentRenderer <|.. PlainTextRenderer
DocumentRenderer <|.. MarkdownRenderer
DocumentRenderer ..> DocumentField
}}
]
rectangle "Main" as Entry #F5F5F5
rectangle "PrintOrder" as Order #F5F5F5
Entry ..> F
Entry ..> G
F ..> S : select
F ..> O : notify
F ..> Order : queue
G ..> Order : read
Order ..> B : job
Order ..> D : service
@enduml
