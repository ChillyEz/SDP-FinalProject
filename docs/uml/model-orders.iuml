package "Builder" as BuilderGroup COLOR_BUILDER {
    class "PrintJob.Builder" as Builder {
        - documentName : String
        - totalPages : int
        - fromPage : int
        - toPage : int
        - copies : int
        + Builder(String, int)
        + range(int, int) : Builder
        + copies(int) : Builder
        + build() : PrintJob
    }

    class PrintJob {
        - documentName : String
        - totalPages : int
        - fromPage : int
        - toPage : int
        - copies : int
        - PrintJob(Builder)
        + documentName() : String
        + totalPages() : int
        + fromPage() : int
        + toPage() : int
        + copies() : int
        + pagesPerCopy() : int
        + printedPages() : int
    }
}

package "Accepted order" as AcceptedorderGroup COLOR_NEUTRAL {
    class PrintOrder {
        - id : int
        - job : PrintJob
        - service : PrintService
        + PrintOrder(int, PrintJob, PrintService)
        + id() : int
        + job() : PrintJob
        + service() : PrintService
        + printedPages() : int
        + summary() : String
        + items() : List<LineItem>
        + totalCost() : long
        + toString() : String
    }
}

package "Decorator" as DecoratorGroup COLOR_DECORATOR {
    interface PrintService <<interface>> {
        + itemsFor(PrintJob) : List<LineItem>
    }

    class BasicPrinting {
        {static} + PRICE_PER_PAGE : int = 20
        {static} + SERVICE_NAME : String = "Printing"
        + itemsFor(PrintJob) : List<LineItem>
    }

    abstract class PrintServiceDecorator {
        - wrapped : PrintService
        - name : String
        # PrintServiceDecorator(PrintService, String)
        {abstract} # costFor(PrintJob) : long
        + itemsFor(PrintJob) : List<LineItem>
    }

    class Cover {
        {static} + PRICE_PER_COPY : int = 100
        {static} + SERVICE_NAME : String = "Cover"
        + Cover(PrintService)
        # costFor(PrintJob) : long
    }

    class Binding {
        {static} + PRICE_PER_COPY : int = 200
        {static} + SERVICE_NAME : String = "Binding"
        + Binding(PrintService)
        # costFor(PrintJob) : long
    }

    class LineItem <<record>> {
        - name : String
        - amount : long
        + LineItem(String, long)
        + name() : String
        + amount() : long
        {static} + formatTenge(long) : String
    }
}

Builder ..> PrintJob : creates
PrintOrder --> "1" PrintJob : job
PrintOrder --> "1" PrintService : service
BasicPrinting ..|> PrintService
PrintServiceDecorator ..|> PrintService
PrintServiceDecorator --> "1" PrintService : wrapped
Cover --|> PrintServiceDecorator
Binding --|> PrintServiceDecorator
PrintService ..> LineItem
