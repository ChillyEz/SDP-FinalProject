package "Facade" as FacadeGroup {
    class PrintCenter {
        - pendingOrders : List<PrintOrder>
        - subscribers : List<PrintSubscriber>
        - printer : ConsolePrinter
        - queuePolicy : QueuePolicy
        - nextOrderId : int
        + PrintCenter()
        + PrintCenter(ConsolePrinter, QueuePolicy)
        + subscribe(PrintSubscriber) : void
        + unsubscribe(PrintSubscriber) : void
        + acceptOrder(PrintJob, PrintService) : PrintOrder
        + setQueuePolicy(QueuePolicy) : void
        + queuePolicy() : QueuePolicy
        + peekNext() : Optional<PrintOrder>
        + pendingOrders() : List<PrintOrder>
        + printNext() : Optional<PrintOrder>
        - notifySubscribers(PrintOrder) : void
    }

    class ConsolePrinter {
        - simulateFailure : boolean
        + setSimulateFailure(boolean) : void
        + print(PrintOrder) : void
    }
}

package "Strategy" as StrategyGroup {
    interface QueuePolicy <<interface>> {
        + selectNext(List<PrintOrder>) : Optional<PrintOrder>
        + name() : String
    }

    class FirstComeFirstServed {
        + selectNext(List<PrintOrder>) : Optional<PrintOrder>
        + name() : String
    }

    class ShortestJobFirst {
        + selectNext(List<PrintOrder>) : Optional<PrintOrder>
        + name() : String
    }
}

package "Observer" as ObserverGroup {
    interface PrintSubscriber <<interface>> {
        + onPrinted(PrintOrder) : void
    }

    class PrintJournal {
        - entries : List<String>
        + onPrinted(PrintOrder) : void
        + entries() : List<String>
        + summary() : String
    }

    class PrintStatistics {
        - completedOrders : int
        - totalPrintedPages : long
        + onPrinted(PrintOrder) : void
        + completedOrders() : int
        + totalPrintedPages() : long
        + summary() : String
    }
}

PrintCenter --> "1" ConsolePrinter : printer
PrintCenter --> "1" QueuePolicy : queuePolicy
PrintCenter --> "0..*" PrintSubscriber : subscribers
FirstComeFirstServed ..|> QueuePolicy
ShortestJobFirst ..|> QueuePolicy
PrintJournal ..|> PrintSubscriber
PrintStatistics ..|> PrintSubscriber
