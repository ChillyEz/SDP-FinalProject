@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam defaultFontColor #172B36
skinparam arrowColor #536976
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #69808A
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam packageFontStyle bold
skinparam packageBorderColor #92A8AE
skinparam roundCorner 7
hide circle
hide empty members
skinparam nodesep 26
skinparam ranksep 26
package "Document content" #F1EDF8 {
    abstract class OrderDocument {
        +render(order) : String
        {abstract} #title(order) : String
        {abstract} #fields(order) : List<DocumentField>
    }
    class Receipt
    class JobTicket
    OrderDocument <|-- Receipt
    OrderDocument <|-- JobTicket
}
package "Output format" #E1F2EE {
    interface DocumentRenderer {
        +render(title, fields) : String
    }
    class PlainTextRenderer
    class MarkdownRenderer
    DocumentRenderer <|.. PlainTextRenderer
    DocumentRenderer <|.. MarkdownRenderer
}
OrderDocument -right-> "1" DocumentRenderer : renderer
@enduml
