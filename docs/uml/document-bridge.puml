@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam defaultFontColor #161616
skinparam arrowColor #555555
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #555555
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam packageFontStyle bold
skinparam packageBorderColor #555555
skinparam roundCorner 0
hide circle
hide empty members
skinparam nodesep 26
skinparam ranksep 26
package "Document content" #F5F5F5 {
    abstract class OrderDocument {
        +render(order) : String
        {abstract} #title(order) : String
        {abstract} #fields(order) : List<DocumentField>
    }
    class Receipt
    class JobTicket
    OrderDocument <|-- Receipt
    OrderDocument <|-- JobTicket
}
package "Output format" #F5F5F5 {
    interface DocumentRenderer {
        +render(title, fields) : String
    }
    class PlainTextRenderer
    class MarkdownRenderer
    DocumentRenderer <|.. PlainTextRenderer
    DocumentRenderer <|.. MarkdownRenderer
}
OrderDocument -right-> "1" DocumentRenderer : renderer
@enduml
